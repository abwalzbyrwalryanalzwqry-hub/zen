{"id":96,"nameAr":"سُورَةُ العَلَقِ","nameEn":"Al-Alaq","count":19,"ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","p":597,"j":30},{"n":2,"t":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","p":597,"j":30},{"n":3,"t":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","p":597,"j":30},{"n":4,"t":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","p":597,"j":30},{"n":5,"t":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","p":597,"j":30},{"n":6,"t":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","p":597,"j":30},{"n":7,"t":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","p":597,"j":30},{"n":8,"t":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","p":597,"j":30},{"n":9,"t":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","p":597,"j":30},{"n":10,"t":"عَبْدًا إِذَا صَلَّىٰٓ","p":597,"j":30},{"n":11,"t":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","p":597,"j":30},{"n":12,"t":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","p":597,"j":30},{"n":13,"t":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","p":597,"j":30},{"n":14,"t":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","p":597,"j":30},{"n":15,"t":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","p":597,"j":30},{"n":16,"t":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","p":597,"j":30},{"n":17,"t":"فَلْيَدْعُ نَادِيَهُۥ","p":597,"j":30},{"n":18,"t":"سَنَدْعُ ٱلزَّبَانِيَةَ","p":597,"j":30},{"n":19,"t":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","p":597,"j":30}]}
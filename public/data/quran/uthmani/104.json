{"id":104,"nameAr":"سُورَةُ الهُمَزَةِ","nameEn":"Al-Humaza","count":9,"ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","p":601,"j":30},{"n":2,"t":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","p":601,"j":30},{"n":3,"t":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","p":601,"j":30},{"n":4,"t":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","p":601,"j":30},{"n":5,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","p":601,"j":30},{"n":6,"t":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","p":601,"j":30},{"n":7,"t":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","p":601,"j":30},{"n":8,"t":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","p":601,"j":30},{"n":9,"t":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","p":601,"j":30}]}
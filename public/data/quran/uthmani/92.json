{"id":92,"nameAr":"سُورَةُ اللَّيۡلِ","nameEn":"Al-Lail","count":21,"ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ","p":595,"j":30},{"n":2,"t":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","p":595,"j":30},{"n":3,"t":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","p":595,"j":30},{"n":4,"t":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","p":595,"j":30},{"n":5,"t":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","p":595,"j":30},{"n":6,"t":"وَصَدَّقَ بِٱلْحُسْنَىٰ","p":595,"j":30},{"n":7,"t":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","p":595,"j":30},{"n":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","p":595,"j":30},{"n":9,"t":"وَكَذَّبَ بِٱلْحُسْنَىٰ","p":595,"j":30},{"n":10,"t":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","p":595,"j":30},{"n":11,"t":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","p":595,"j":30},{"n":12,"t":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","p":595,"j":30},{"n":13,"t":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","p":595,"j":30},{"n":14,"t":"فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ","p":595,"j":30},{"n":15,"t":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","p":596,"j":30},{"n":16,"t":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","p":596,"j":30},{"n":17,"t":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","p":596,"j":30},{"n":18,"t":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","p":596,"j":30},{"n":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ","p":596,"j":30},{"n":20,"t":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","p":596,"j":30},{"n":21,"t":"وَلَسَوْفَ يَرْضَىٰ","p":596,"j":30}]}
{"id":93,"nameAr":"سُورَةُ الضُّحَىٰ","nameEn":"Ad-Dhuhaa","count":11,"ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","p":596,"j":30},{"n":2,"t":"وَٱلَّيْلِ إِذَا سَجَىٰ","p":596,"j":30},{"n":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","p":596,"j":30},{"n":4,"t":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","p":596,"j":30},{"n":5,"t":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","p":596,"j":30},{"n":6,"t":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","p":596,"j":30},{"n":7,"t":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","p":596,"j":30},{"n":8,"t":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","p":596,"j":30},{"n":9,"t":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","p":596,"j":30},{"n":10,"t":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","p":596,"j":30},{"n":11,"t":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","p":596,"j":30}]}
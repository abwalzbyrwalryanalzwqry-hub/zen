{"id":86,"nameAr":"سُورَةُ الطَّارِقِ","nameEn":"At-Taariq","count":17,"ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","p":591,"j":30},{"n":2,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","p":591,"j":30},{"n":3,"t":"ٱلنَّجْمُ ٱلثَّاقِبُ","p":591,"j":30},{"n":4,"t":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","p":591,"j":30},{"n":5,"t":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","p":591,"j":30},{"n":6,"t":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","p":591,"j":30},{"n":7,"t":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","p":591,"j":30},{"n":8,"t":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","p":591,"j":30},{"n":9,"t":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","p":591,"j":30},{"n":10,"t":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","p":591,"j":30},{"n":11,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","p":591,"j":30},{"n":12,"t":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","p":591,"j":30},{"n":13,"t":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","p":591,"j":30},{"n":14,"t":"وَمَا هُوَ بِٱلْهَزْلِ","p":591,"j":30},{"n":15,"t":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","p":591,"j":30},{"n":16,"t":"وَأَكِيدُ كَيْدًۭا","p":591,"j":30},{"n":17,"t":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","p":591,"j":30}]}
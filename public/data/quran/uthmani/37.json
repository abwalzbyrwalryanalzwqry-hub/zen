{"id":37,"nameAr":"سُورَةُ الصَّافَّاتِ","nameEn":"As-Saaffaat","count":182,"ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلصَّٰٓفَّٰتِ صَفًّۭا","p":446,"j":23},{"n":2,"t":"فَٱلزَّٰجِرَٰتِ زَجْرًۭا","p":446,"j":23},{"n":3,"t":"فَٱلتَّٰلِيَٰتِ ذِكْرًا","p":446,"j":23},{"n":4,"t":"إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌۭ","p":446,"j":23},{"n":5,"t":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ","p":446,"j":23},{"n":6,"t":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ","p":446,"j":23},{"n":7,"t":"وَحِفْظًۭا مِّن كُلِّ شَيْطَٰنٍۢ مَّارِدٍۢ","p":446,"j":23},{"n":8,"t":"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍۢ","p":446,"j":23},{"n":9,"t":"دُحُورًۭا ۖ وَلَهُمْ عَذَابٌۭ وَاصِبٌ","p":446,"j":23},{"n":10,"t":"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌۭ ثَاقِبٌۭ","p":446,"j":23},{"n":11,"t":"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَٰهُم مِّن طِينٍۢ لَّازِبٍۭ","p":446,"j":23},{"n":12,"t":"بَلْ عَجِبْتَ وَيَسْخَرُونَ","p":446,"j":23},{"n":13,"t":"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ","p":446,"j":23},{"n":14,"t":"وَإِذَا رَأَوْا۟ ءَايَةًۭ يَسْتَسْخِرُونَ","p":446,"j":23},{"n":15,"t":"وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ مُّبِينٌ","p":446,"j":23},{"n":16,"t":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","p":446,"j":23},{"n":17,"t":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","p":446,"j":23},{"n":18,"t":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ","p":446,"j":23},{"n":19,"t":"فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ فَإِذَا هُمْ يَنظُرُونَ","p":446,"j":23},{"n":20,"t":"وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ","p":446,"j":23},{"n":21,"t":"هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","p":446,"j":23},{"n":22,"t":"۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ","p":446,"j":23},{"n":23,"t":"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ","p":446,"j":23},{"n":24,"t":"وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ","p":446,"j":23},{"n":25,"t":"مَا لَكُمْ لَا تَنَاصَرُونَ","p":447,"j":23},{"n":26,"t":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ","p":447,"j":23},{"n":27,"t":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ","p":447,"j":23},{"n":28,"t":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ","p":447,"j":23},{"n":29,"t":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ","p":447,"j":23},{"n":30,"t":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًۭا طَٰغِينَ","p":447,"j":23},{"n":31,"t":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ","p":447,"j":23},{"n":32,"t":"فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ","p":447,"j":23},{"n":33,"t":"فَإِنَّهُمْ يَوْمَئِذٍۢ فِى ٱلْعَذَابِ مُشْتَرِكُونَ","p":447,"j":23},{"n":34,"t":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","p":447,"j":23},{"n":35,"t":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ","p":447,"j":23},{"n":36,"t":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍۢ مَّجْنُونٍۭ","p":447,"j":23},{"n":37,"t":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ","p":447,"j":23},{"n":38,"t":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ","p":447,"j":23},{"n":39,"t":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","p":447,"j":23},{"n":40,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","p":447,"j":23},{"n":41,"t":"أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌۭ مَّعْلُومٌۭ","p":447,"j":23},{"n":42,"t":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ","p":447,"j":23},{"n":43,"t":"فِى جَنَّٰتِ ٱلنَّعِيمِ","p":447,"j":23},{"n":44,"t":"عَلَىٰ سُرُرٍۢ مُّتَقَٰبِلِينَ","p":447,"j":23},{"n":45,"t":"يُطَافُ عَلَيْهِم بِكَأْسٍۢ مِّن مَّعِينٍۭ","p":447,"j":23},{"n":46,"t":"بَيْضَآءَ لَذَّةٍۢ لِّلشَّٰرِبِينَ","p":447,"j":23},{"n":47,"t":"لَا فِيهَا غَوْلٌۭ وَلَا هُمْ عَنْهَا يُنزَفُونَ","p":447,"j":23},{"n":48,"t":"وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌۭ","p":447,"j":23},{"n":49,"t":"كَأَنَّهُنَّ بَيْضٌۭ مَّكْنُونٌۭ","p":447,"j":23},{"n":50,"t":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ","p":447,"j":23},{"n":51,"t":"قَالَ قَآئِلٌۭ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌۭ","p":447,"j":23},{"n":52,"t":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ","p":448,"j":23},{"n":53,"t":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ","p":448,"j":23},{"n":54,"t":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ","p":448,"j":23},{"n":55,"t":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ","p":448,"j":23},{"n":56,"t":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ","p":448,"j":23},{"n":57,"t":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ","p":448,"j":23},{"n":58,"t":"أَفَمَا نَحْنُ بِمَيِّتِينَ","p":448,"j":23},{"n":59,"t":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ","p":448,"j":23},{"n":60,"t":"إِنَّ هَٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","p":448,"j":23},{"n":61,"t":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ ٱلْعَٰمِلُونَ","p":448,"j":23},{"n":62,"t":"أَذَٰلِكَ خَيْرٌۭ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ","p":448,"j":23},{"n":63,"t":"إِنَّا جَعَلْنَٰهَا فِتْنَةًۭ لِّلظَّٰلِمِينَ","p":448,"j":23},{"n":64,"t":"إِنَّهَا شَجَرَةٌۭ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ","p":448,"j":23},{"n":65,"t":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ","p":448,"j":23},{"n":66,"t":"فَإِنَّهُمْ لَءَاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","p":448,"j":23},{"n":67,"t":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًۭا مِّنْ حَمِيمٍۢ","p":448,"j":23},{"n":68,"t":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ","p":448,"j":23},{"n":69,"t":"إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ","p":448,"j":23},{"n":70,"t":"فَهُمْ عَلَىٰٓ ءَاثَٰرِهِمْ يُهْرَعُونَ","p":448,"j":23},{"n":71,"t":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ","p":448,"j":23},{"n":72,"t":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ","p":448,"j":23},{"n":73,"t":"فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُنذَرِينَ","p":448,"j":23},{"n":74,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","p":448,"j":23},{"n":75,"t":"وَلَقَدْ نَادَىٰنَا نُوحٌۭ فَلَنِعْمَ ٱلْمُجِيبُونَ","p":448,"j":23},{"n":76,"t":"وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ","p":4
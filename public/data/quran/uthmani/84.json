{"id":84,"nameAr":"سُورَةُ الانشِقَاقِ","nameEn":"Al-Inshiqaaq","count":25,"ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","p":589,"j":30},{"n":2,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","p":589,"j":30},{"n":3,"t":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","p":589,"j":30},{"n":4,"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","p":589,"j":30},{"n":5,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","p":589,"j":30},{"n":6,"t":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ","p":589,"j":30},{"n":7,"t":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ","p":589,"j":30},{"n":8,"t":"فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا","p":589,"j":30},{"n":9,"t":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا","p":589,"j":30},{"n":10,"t":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","p":589,"j":30},{"n":11,"t":"فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا","p":589,"j":30},{"n":12,"t":"وَيَصْلَىٰ سَعِيرًا","p":589,"j":30},{"n":13,"t":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","p":589,"j":30},{"n":14,"t":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","p":589,"j":30},{"n":15,"t":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا","p":589,"j":30},{"n":16,"t":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","p":589,"j":30},{"n":17,"t":"وَٱلَّيْلِ وَمَا وَسَقَ","p":589,"j":30},{"n":18,"t":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","p":589,"j":30},{"n":19,"t":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ","p":589,"j":30},{"n":20,"t":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","p":589,"j":30},{"n":21,"t":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩","p":589,"j":30},{"n":22,"t":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","p":589,"j":30},{"n":23,"t":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","p":589,"j":30},{"n":24,"t":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","p":589,"j":30},{"n":25,"t":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","p":589,"j":30}]}
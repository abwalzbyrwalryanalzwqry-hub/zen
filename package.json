{
  "name": "zen",
  "version": "1.37.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-native.mjs --no-sync",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test:db": "node supabase/tests/run-migrations-test.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:tz": "TZ=Asia/Jakarta vitest run src/lib/local-day.test.ts && TZ=America/Los_Angeles vitest run src/lib/local-day.test.ts",
    "test:e2e": "playwright test",
    "seed:demo": "node scripts/seed-demo.mjs",
    "gen:types": "node scripts/gen-db-types.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:i18n": "node scripts/i18n-progress.mjs --check",
    "check:shared": "node scripts/check-shared-mirror.mjs",
    "check:types-fresh": "node scripts/gen-db-types.mjs --check",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "build:apk-web": "node scripts/build-native.mjs",
    "build:apk": "node scripts/build-native.mjs && cd android && ./gradlew assembleRelease",
    "ai:eval": "node scripts/ai-eval.mjs",
    "ai:eval:recitation": "node scripts/recitation-eval.mjs",
    "test:load": "node scripts/load-test.mjs",
    "hooks:install": "git config core.hooksPath scripts/git-hooks"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/router-plugin": "^1.168.18",
    "adhan": "^4.4.6",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@lovable.dev/vite-tanstack-config": "2.13.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

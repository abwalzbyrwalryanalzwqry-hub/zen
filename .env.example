# ─────────── متغيّرات بيئة مشروع Zen ───────────
# ‎.env‎ المتتبَّع في Git يحوي القيم العامة (VITE_* وSUPABASE_URL/PUBLISHABLE_KEY) فقط، ويحتاجه
# Lovable لتشغيل التطبيق. ضع الأسرار أدناه في .env.local (غير متتبَّع) أو في Secrets على Lovable.

# Supabase (متاحة للعميل — مفاتيح عامة publishable)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# نفس القيم للاستخدام في التصيير على الخادم (SSR)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_PROJECT_ID=<project-ref>

# سرّية — لا تُضَف أبداً إلى متغيّر يبدأ بـ VITE_. منذ المرحلة 6.5 لا يحتاجها الويب:
# مفتاح الذكاء يوضع في أسرار دوال Edge في Supabase، ومفتاح الخدمة للسكربتات المحلية فقط (seed:demo).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
LOVABLE_API_KEY=<lovable-ai-gateway-key>

# اختياري — مزوّدو ذكاء اصطناعي احتياطيون (المرحلة 14). يُجرَّب المزوّدون بهذا الترتيب، ويُتخطّى
# من لا مفتاح له؛ عند 429/402/5xx أو انقطاع يُنتقل للتالي. OpenAI لا يستقبل الصوت فيُتخطّى في التفريغ.
# AI_PROVIDERS=lovable,openai,gemini
# LOVABLE_AI_MODEL=google/gemini-3-flash-preview
# OPENAI_API_KEY=<openai-key>
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=<google-ai-studio-key>
# GEMINI_MODEL=gemini-3.5-flash
# بدائل تُجرَّب بالترتيب عند 404 (نموذج أُوقف)؛ تُغيَّر من أسرار Edge دون نشر شيفرة:
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite
# OPENAI_FALLBACK_MODELS=gpt-4o-mini

# الإشعارات (Android فقط، FCM) — أسرار دالة Edge zen-push-dispatch، لا تُبنى في التطبيق.
# سرّ المجدول (سلسلة عشوائية طويلة):
# PUSH_DISPATCH_SECRET=<random-secret>
# زِن تطبيق Android فقط: لا Web Push ولا VAPID ولا رابط ويب يحمّله الغلاف (CAP_SERVER_URL أُزيل في 6.10).
# حساب خدمة Firebase لإرسال FCM (محتوى JSON في سطر واحد). خادم فقط — لا VITE_ أبداً:
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
